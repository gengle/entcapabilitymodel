# Self-describing semantic model: capability tree (L1-L4) + typed entities + declared relation types.
root Capability
  level 1 Domain
  level 2 Capability group
  level 3 Capability
  level 4 Sub-capability
  prop owner: string inherit required
  prop criticality: enum(low,medium,high) = medium inherit
  prop review_cycle_days: int = 180 inherit
  prop maturity: enum(initial,pilot,defined,optimized) = initial
  prop lifecycle: enum(plan,active,retire) = active
  rule no_active_under_retired
  rule unmet_requirements warn

entity_type Asset
  prop owner: string
  prop lifecycle: enum(plan,active,retire) = active
entity_type Application : Asset
  prop vendor: string
entity_type Service : Asset
entity_type Team
  prop head: string
  prop lifecycle: enum(plan,active,retire) = active

relation exposes
  from Asset|Team
  to Capability
  attr coverage: enum(full,partial) = full
  inverse exposed_by
  min_level 3
  conflicts_with requires
relation requires
  from Asset|Team
  to Capability
  attr dependency: enum(hard,soft) = hard
  inverse required_by
  min_level 3
  satisfied_by exposes
relation depends_on
  from Application
  to Application|Service
  attr criticality: enum(low,medium,high) = medium
  inverse dependents
  transitive
  no_cycles

capability Finance
  set owner = "CFO Office"
  set criticality = high
  set review_cycle_days = 90
  capability Accounts Payable
    set owner = "Dana Reyes"
    capability Invoice Management
      capability Invoice Capture
        set maturity = defined
      capability Three-Way Matching
        set maturity = pilot
      capability Invoice Approval
        set maturity = defined
    capability Supplier Payments
      set maturity = optimized
      capability Payment Run
        set maturity = optimized
      capability Payment Reconciliation
        set maturity = defined
  capability Financial Planning
    set criticality = medium
    capability Budgeting
      set maturity = defined
    capability Forecasting
capability Human Resources
  set owner = "CHRO Office"
  capability Talent Acquisition
    capability Recruiting
      capability Candidate Sourcing
        set maturity = defined
      capability Interview Scheduling
    capability Onboarding
capability Technology
  set owner = "CIO Office"
  set criticality = high
  capability Security
    capability Access Management
      capability Single Sign-On
        set maturity = optimized
      capability Privileged Access

entity Application SAP S/4
  set vendor = SAP
  set owner = "Finance IT"
  exposes Invoice Approval
  exposes Payment Run
  exposes Budgeting [coverage=partial]
entity Application ApproveIt
  set owner = "Finance IT"
  exposes Invoice Approval [coverage=partial]
  requires Single Sign-On
  requires Privileged Access
  depends_on SAP S/4 [criticality=high]
entity Application OCR Capture
  set vendor = ScanCo
  exposes Invoice Capture
  requires Single Sign-On
  depends_on Corporate SSO
entity Application Match Engine
  set owner = "Finance IT"
  exposes Three-Way Matching [coverage=partial]
  requires Invoice Capture
  depends_on OCR Capture [criticality=high]
entity Application Talent Platform
  set vendor = "Acme HR Cloud"
  exposes Recruiting
  requires Single Sign-On
entity Service Corporate SSO
  set owner = "Identity Team"
  exposes Single Sign-On
entity Team AP Operations
  set head = "Dana Reyes"
  exposes Payment Reconciliation
  exposes Invoice Approval [coverage=partial]
