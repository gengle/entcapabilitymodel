{
  "openapi": "3.0.3",
  "info": {
    "title": "Capability model API",
    "version": "1.0.0"
  },
  "paths": {
    "/capabilities": {
      "get": {
        "summary": "List capabilities",
        "parameters": [
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Capability"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/capabilities/{path}": {
      "get": {
        "summary": "Get a capability",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capability"
                }
              }
            }
          }
        }
      }
    },
    "/coverage": {
      "get": {
        "summary": "Providers per capability",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/gaps": {
      "get": {
