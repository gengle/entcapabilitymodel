    "/entities/{name}/depends_on": {
      "get": {
        "summary": "depends_on links (Application -> Application|Service)",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
